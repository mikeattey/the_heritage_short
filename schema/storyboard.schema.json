{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["title", "logline", "style_block", "characters", "setting", "shots", "music", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "logline": {"type": "string", "minLength": 1},
    "feel": {"type": "string", "description": "What the audience should feel at the end"},
    "style_block": {"type": "string", "minLength": 10, "description": "Prepended to every keyframe prompt"},
    "characters": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 10},
      "description": "Fixed description per character; a shot's cast picks which are added to its prompt"
    },
    "setting": {"type": "string", "minLength": 10, "description": "The one place, added to every keyframe prompt"},
    "seed": {"type": "integer", "default": 42},
    "narration_lang": {"type": "string", "default": "am", "description": "Language of spoken narration"},
    "shots": {
      "type": "array", "minItems": 5, "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["id", "reason", "duration", "keyframe_prompt", "narration", "subtitle"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "reason": {"type": "string", "minLength": 5, "description": "Why this shot exists"},
          "duration": {"type": "number", "minimum": 3, "maximum": 15},
          "keyframe_prompt": {"type": "string", "minLength": 10},
          "cast": {"type": "array", "items": {"type": "string"}, "description": "Keys of characters that appear in this shot"},
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "engine": {"enum": ["kenburns", "wan"], "default": "kenburns"},
              "kind": {"enum": ["zoom_in", "zoom_out", "pan_left", "pan_right"], "default": "zoom_in"},
              "wan_prompt": {"type": "string"},
              "focus": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "description": "Vertical position of the 16:9 crop window on the square keyframe: 0 = top, 0.5 = centre, 1 = bottom. No effect on 9:16, which keeps the full height"},
              "focus_x": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "description": "Horizontal position of the 9:16 crop window on the square keyframe: 0 = left, 0.5 = centre, 1 = right. No effect on 16:9"}
            }
          },
          "speaker": {"enum": ["narrator", "mother"], "default": "narrator", "description": "Which TTS voice speaks this line"},
          "narration": {"type": "string", "description": "Spoken text, in the narration language (Amharic)"},
          "narration_take": {"type": "integer", "minimum": 0, "default": 0, "description": "Re-roll the voice for this line: >0 is sent to the TTS as a seed and changes the cache key, so only this clip regenerates"},
          "subtitle": {"type": "string", "description": "English text burned in as subtitle"}
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["prompt", "duration"],
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string"},
        "duration": {"type": "number", "minimum": 30, "maximum": 120},
        "chosen": {"type": "string", "description": "Filename of chosen candidate in outputs/music/"}
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string"},
        "subline": {"type": "string", "description": "Second line (the proverb in Amharic script)"},
        "duration": {"type": "number", "default": 4}
      }
    }
  }
}
