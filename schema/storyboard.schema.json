{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["title", "logline", "style_block", "character", "shots", "music", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "logline": {"type": "string", "minLength": 1},
    "feel": {"type": "string", "description": "What the audience should feel at the end"},
    "style_block": {"type": "string", "minLength": 10, "description": "Prepended to every keyframe prompt"},
    "character": {"type": "string", "minLength": 10, "description": "Fixed character description, prepended to every prompt"},
    "seed": {"type": "integer", "default": 42},
    "shots": {
      "type": "array", "minItems": 5, "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["id", "reason", "duration", "keyframe_prompt", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "reason": {"type": "string", "minLength": 5, "description": "Why this shot exists"},
          "duration": {"type": "number", "minimum": 3, "maximum": 15},
          "keyframe_prompt": {"type": "string", "minLength": 10},
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "engine": {"enum": ["kenburns", "wan"], "default": "kenburns"},
              "kind": {"enum": ["zoom_in", "zoom_out", "pan_left", "pan_right"], "default": "zoom_in"},
              "wan_prompt": {"type": "string"}
            }
          },
          "narration": {"type": "string"}
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["prompt", "duration"],
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string"},
        "duration": {"type": "number", "minimum": 30, "maximum": 120},
        "chosen": {"type": "string", "description": "Filename of chosen candidate in outputs/music/"}
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {"text": {"type": "string"}, "duration": {"type": "number", "default": 4}}
    }
  }
}
